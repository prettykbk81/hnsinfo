# .streamlit/secrets.toml.example
#
# 이 파일은 커밋 가능한 예시 템플릿입니다.
# 실제 키는 이 파일이 아닌 .streamlit/secrets.toml 에 입력하세요.
# secrets.toml 은 .gitignore 에 등록되어 GitHub에 올라가지 않습니다.
#
# 사용법:
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   그 다음 secrets.toml 을 열어 실제 값을 입력하세요.

# ── Claude API (필수) ──────────────────────────────────────
ANTHROPIC_API_KEY = "sk-ant-api03-여기에_실제_키_입력"

# 모델 선택 (기본값: haiku — 빠르고 저렴)
# 고품질이 필요하면: claude-sonnet-4-6
ANTHROPIC_MODEL = "claude-haiku-4-5-20251001"

# ── Notion 연동 (선택사항) ────────────────────────────────
# Notion → Settings → Connections → Integrations → New → Internal Token 복사
NOTION_TOKEN = "secret_여기에_Notion_통합_토큰_입력"

# 데이터베이스 URL: notion.so/.../[여기가_DATABASE_ID]?v=...
NOTION_DATABASE_ID = "여기에_32자리_데이터베이스_ID_입력"
